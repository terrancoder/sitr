{
  "manifest_version": 3,
  "name": "Sitr — Halal & Family Content Filter",
  "version": "0.1.0",
  "description": "On-device adult-content filtering and SafeSearch enforcement. Your browsing history never leaves your browser.",
  "permissions": ["declarativeNetRequest", "storage", "alarms"],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "host_permissions": [
    "https://sync.sitr.app/*",
    "*://*.google.com/*",
    "*://www.bing.com/*",
    "*://duckduckgo.com/*",
    "*://*.youtube.com/*",
    "*://youtubei.googleapis.com/*"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "public/icon16.png",
    "32": "public/icon32.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Sitr",
    "default_icon": {
      "16": "public/icon16.png",
      "32": "public/icon32.png",
      "48": "public/icon48.png",
      "128": "public/icon128.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "sitr_adult",
        "enabled": true,
        "path": "rulesets/adult.json"
      },
      {
        "id": "sitr_gambling",
        "enabled": true,
        "path": "rulesets/gambling.json"
      },
      {
        "id": "sitr_dating",
        "enabled": true,
        "path": "rulesets/dating.json"
      },
      {
        "id": "sitr_safesearch",
        "enabled": true,
        "path": "rulesets/safesearch.json"
      }
    ]
  }
}
