<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Standard, mass-market crypto only: HTTPS plus WebCrypto AES-GCM for
	     the user's own E2E-encrypted Family blob — the exempt category. -->
	<!-- The app menu and Finder show CFBundleName; the product/target name
	     stays SitrMac to keep build paths distinct from the iOS app. -->
	<key>CFBundleName</key>
	<string>Sitr</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
