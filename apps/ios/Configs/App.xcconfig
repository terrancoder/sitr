#include "Shared.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.sitrshield.sitr
CODE_SIGN_ENTITLEMENTS = Sitr/Sitr.entitlements
INFOPLIST_FILE = Sitr/Info.plist
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_CFBundleDisplayName = Sitr
// Camera is used ONLY to scan a pairing QR code, on the user's tap.
INFOPLIST_KEY_NSCameraUsageDescription = Sitr uses the camera only to scan a household pairing code.
