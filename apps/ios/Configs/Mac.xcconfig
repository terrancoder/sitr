#include "MacShared.xcconfig"

// macOS host app for the Safari Web Extension (Udocs/extension-dev-plan.md
// workstream B). Safari 26 is the supported floor; macOS 14 is the oldest
// macOS that runs it.
PRODUCT_BUNDLE_IDENTIFIER = com.sitrshield.sitr.mac
CODE_SIGN_ENTITLEMENTS = SitrMac/SitrMac.entitlements
INFOPLIST_KEY_CFBundleDisplayName = Sitr
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
INFOPLIST_FILE = SitrMac/Info.plist
