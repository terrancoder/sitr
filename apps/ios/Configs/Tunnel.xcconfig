#include "Shared.xcconfig"

// SitrTunnel: the opt-in DNS filter (packet tunnel). Embedded and signed
// in Debug and Release. With SITR_DNS_FILTER = NO the app does not embed
// it (App.xcconfig); the target dependency still compiles it, unsigned,
// so that variant needs no Network Extension profile.
PRODUCT_BUNDLE_IDENTIFIER = com.sitrshield.sitr.tunnel
SITR_TUNNEL_ENTITLEMENTS_YES = SitrTunnel/SitrTunnel.entitlements
SITR_TUNNEL_ENTITLEMENTS_NO =
CODE_SIGN_ENTITLEMENTS = $(SITR_TUNNEL_ENTITLEMENTS_$(SITR_DNS_FILTER))
INFOPLIST_FILE = SitrTunnel/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Sitr DNS filter
SKIP_INSTALL = YES
SITR_TUNNEL_SIGN_YES = YES
SITR_TUNNEL_SIGN_NO = NO
CODE_SIGNING_ALLOWED = $(SITR_TUNNEL_SIGN_$(SITR_DNS_FILTER))
