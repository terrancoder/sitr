#include "Shared.xcconfig"

// SitrTunnel: DEBUG-ONLY feasibility prototype of the Android DNS filter
// (packet tunnel). The app embeds it only in Debug (App.xcconfig
// EXCLUDED_SOURCE_FILE_NAMES[config=Release]); Release still compiles
// this target through the dependency but never signs it, so a Release
// archive needs no Network Extension profile.
PRODUCT_BUNDLE_IDENTIFIER = com.sitrshield.sitr.tunnel
CODE_SIGN_ENTITLEMENTS = SitrTunnel/SitrTunnel.entitlements
INFOPLIST_FILE = SitrTunnel/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Sitr DNS (experimental)
SKIP_INSTALL = YES
CODE_SIGNING_ALLOWED[config=Release] = NO
CODE_SIGN_ENTITLEMENTS[config=Release] =
