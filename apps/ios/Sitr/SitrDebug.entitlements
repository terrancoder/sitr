<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- DEBUG configuration only (App.xcconfig CODE_SIGN_ENTITLEMENTS[config=Debug]).
	     Sitr.entitlements plus the Network Extension entitlement the
	     experimental DNS-filter prototype needs for NETunnelProviderManager.
	     Release keeps using Sitr.entitlements, unchanged. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sitrshield.sitr</string>
	</array>
	<key>com.apple.developer.family-controls</key>
	<true/>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
</dict>
</plist>
