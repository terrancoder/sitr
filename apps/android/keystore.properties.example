# Copy to keystore.properties (gitignored) to sign release builds with the
# Play upload key. Paths are relative to apps/android/.
#
# Create the key once (choose a strong password; store both files in the
# company password manager, not only on this laptop):
#   keytool -genkeypair -v -keystore sitr-upload.jks -alias sitr-upload \
#     -keyalg RSA -keysize 4096 -validity 36500 \
#     -dname "CN=Sitr, O=Dooplin, C=ES"
storeFile=sitr-upload.jks
storePassword=CHANGE_ME
keyAlias=sitr-upload
keyPassword=CHANGE_ME
