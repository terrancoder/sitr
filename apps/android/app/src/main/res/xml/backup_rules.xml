<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 counterpart of data_extraction_rules.xml. allowBackup
     is already false; this makes the "nothing leaves the device" rule
     explicit for the legacy backup path too. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
