<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ analogue of allowBackup="false": nothing is backed up to
     the cloud or copied in a device-to-device transfer. Settings hold the
     Keystore-wrapped household secret and the PIN record, which must not
     leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
